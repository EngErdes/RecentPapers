# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Notion integration token — https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...

# Gmail IMAP — アプリパスワード方式（OAuth ではない）
# GMAIL_USER: 対象の Gmail / Workspace アドレス
# GMAIL_APP_PASSWORD: https://myaccount.google.com/apppasswords で発行した16文字
#   （表示どおり空白区切りのまま貼り付けても可）
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# (Optional) Override the target Notion database ID
# NOTION_DATABASE_ID=34ea03616fa080d88a97d6eb8549c0a0
